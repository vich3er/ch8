    owl:imports fhir: .

:AlertAction a owl:Class ;
    rdfs:subClassOf :Action .

:ChronicCondition a owl:Class ;
    rdfs:subClassOf :MedicalCondition .

:Doctor a owl:Class ;
    rdfs:subClassOf :HealthcareProvider .

:HeartRate a owl:Class ;
    rdfs:subClassOf :VitalSign .

:MedicationAdjustment a owl:Class ;
    rdfs:subClassOf :Action .

:NeutralSentiment a owl:Class ;
    rdfs:subClassOf :Sentiment ;
    owl:disjointWith :PositiveSentiment .

:Nurse a owl:Class ;
    rdfs:subClassOf :HealthcareProvider .

:PainSymptom a owl:Class ;
    rdfs:subClassOf :Symptom .

:PulseOximeter a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom :OxygenSaturation ;
            owl:onProperty :measuresVitalSign ],
        :MedicalDevice .

:RespiratorySymptom a owl:Class ;
    rdfs:subClassOf :Symptom .

:ServiceFeedback a owl:Class ;
    rdfs:subClassOf :PatientFeedback ;
    owl:disjointWith :SymptomFeedback .

:WearableSensor a owl:Class ;
    rdfs:subClassOf :MedicalDevice .

