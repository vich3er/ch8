:Action a owl:Class .

:HealthcareProvider a owl:Class .

:MedicalCondition a owl:Class .

:NegativeSentiment a owl:Class ;
    rdfs:subClassOf :Sentiment ;
    owl:disjointWith :NeutralSentiment .

:OxygenSaturation a owl:Class ;
    rdfs:subClassOf :VitalSign .

:fb_01 a :SymptomFeedback,
        owl:NamedIndividual ;
    :hasFeedbackText "Задишка посилилась під час ходьби" ;
    :hasSentiment :sent_neg_01 ;
    :hasTimestamp "2026-10-20T10:00:00+00:00"^^xsd:dateTime ;
    :mentionsSymptom :symptom_dyspnea ;
    :submittedBy :patient_01 .

:fb_03 a :SymptomFeedback,
        owl:NamedIndividual ;
    :hasSentiment :sent_neg_02 ;
    :hasTimestamp "2026-10-22T08:15:00+00:00"^^xsd:dateTime ;
    :mentionsSymptom :symptom_chest_pain ;
    :submittedBy :patient_03 .

:patient_03 a :Patient,
        owl:NamedIndividual ;
    :hasFeedback :fb_03 ;
    :hasVitalSign :vital_sign_03 ;
    :isMonitoredBy :dev_device_03,
        :dev_smartwatch_01 .

:submittedBy a owl:FunctionalProperty,
        owl:ObjectProperty .

:symptom_dyspnea a :RespiratorySymptom,
        owl:NamedIndividual ;
    :hasSeverity "Severe" .

:PositiveSentiment a owl:Class ;
    rdfs:subClassOf :Sentiment .

:SymptomFeedback a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :mentionsSymptom ;
            owl:someValuesFrom :Symptom ],
        :PatientFeedback .

:patient_01 a :Patient,
        owl:NamedIndividual ;
    :hasFeedback :fb_01 ;
    :hasVitalSign :vital_sign_01 ;
    :isMonitoredBy :dev_device_01,
        :dev_pulse_ox_01 .

:Sentiment a owl:Class .

:PatientFeedback a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :Patient ;
            owl:onProperty :submittedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

:Symptom a owl:Class .

:Patient a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasFeedback ;
            owl:someValuesFrom :PatientFeedback ] .

:MedicalDevice a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :hasDeviceID ] .

:VitalSign a owl:Class .

